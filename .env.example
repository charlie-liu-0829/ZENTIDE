# Spring profile. Use prod in deployment.
SPRING_PROFILES_ACTIVE=dev

# MySQL connection (never commit real credentials)
ZENTIDE_DB_URL=jdbc:mysql://127.0.0.1:3306/zentide?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=GMT%2B8&characterEncoding=UTF-8
ZENTIDE_DB_USERNAME=root
ZENTIDE_DB_PASSWORD=change-me
ZENTIDE_DB_ROOT_PASSWORD=change-root-password

# Redis
ZENTIDE_REDIS_HOST=127.0.0.1
ZENTIDE_REDIS_PORT=6379

# Optional Elasticsearch REST endpoint. When empty, the API falls back to MySQL.
ZENTIDE_ELASTICSEARCH_URL=http://127.0.0.1:9200
ZENTIDE_ELASTICSEARCH_POSTS_INDEX=zentide_posts
ZENTIDE_ELASTICSEARCH_HUBS_INDEX=zentide_hubs

# Community Agent. Use the same random internal token for Python and zentide-web.
DASHSCOPE_API_KEY=change-me
ZENTIDE_AGENT_URL=http://127.0.0.1:8090
ZENTIDE_AGENT_HOST=127.0.0.1
ZENTIDE_AGENT_PORT=8090
ZENTIDE_AGENT_INTERNAL_TOKEN=replace-with-a-random-long-string
ZENTIDE_PROJECT_ROOT=/absolute/path/to/ZENTIDE
ZENTIDE_COMMUNITY_URL=http://localhost:6001
ZENTIDE_POST_REVIEW_URL=http://127.0.0.1:8091
ZENTIDE_POST_REVIEW_HOST=127.0.0.1
ZENTIDE_POST_REVIEW_PORT=8091
ZENTIDE_KNOWLEDGE_SNAPSHOT_DIR=/absolute/path/to/ZENTIDE/data/knowledge-snapshots

# Fresh databases are initialized by zentide.sql. Enable this only when
# intentionally upgrading an older database that already has Flyway history.
ZENTIDE_FLYWAY_ENABLED=false

# Admin credentials
ZENTIDE_ADMIN_ACCOUNT=admin
ZENTIDE_ADMIN_PASSWORD=change-me-now
ZENTIDE_ANALYSIS_API_KEY=
