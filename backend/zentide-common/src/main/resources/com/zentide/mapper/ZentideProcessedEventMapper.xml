<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zentide.mapper.ZentideProcessedEventMapper">

    <insert id="insert">
        <![CDATA[
INSERT IGNORE INTO zentide_processed_event(consumer_name,event_id,processed_at) VALUES(#{consumerName},#{eventId},CURRENT_TIMESTAMP(3))
        ]]>
    </insert>

</mapper>
