# 阿里云百炼 DashScope API Key
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-api-key-here

# ZENTIDE 兴趣情报服务
ZENTIDE_RECOMMEND_HOST=127.0.0.1
ZENTIDE_RECOMMEND_PORT=8092
ZENTIDE_RECOMMEND_MODEL=qwen3-max
ZENTIDE_AGENT_INTERNAL_TOKEN=replace-with-a-long-random-token
ZENTIDE_KNOWLEDGE_SNAPSHOT_DIR=/path/to/ZENTIDE/data/knowledge-snapshots
ZENTIDE_INTEREST_DB=/path/to/runtime/interests.sqlite3
