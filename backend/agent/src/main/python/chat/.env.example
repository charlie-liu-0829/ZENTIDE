# 阿里云百炼 DashScope API Key
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-api-key-here

# Python API only listens locally. Set the same token on zentide-web.
ZENTIDE_AGENT_HOST=127.0.0.1
ZENTIDE_AGENT_PORT=8090
ZENTIDE_AGENT_INTERNAL_TOKEN=replace-with-a-random-long-string
ZENTIDE_COMMUNITY_URL=http://localhost:6001
